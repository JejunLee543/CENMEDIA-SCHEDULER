{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.local/node/bin:$PATH\"; exec npm run dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dev-attach",
      "url": "http://localhost:3001",
      "port": 3001
    }
  ]
}
